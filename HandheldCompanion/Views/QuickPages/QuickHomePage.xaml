<Page
    x:Class="HandheldCompanion.Views.QuickPages.QuickHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:HandheldCompanion.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:l="clr-namespace:HandheldCompanion.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:HandheldCompanion.Properties"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:viewmodels="clr-namespace:HandheldCompanion.ViewModels"
    Name="QuickHome"
    Title="{l:Static resx:Resources.QuickHomePage_Title}"
    Margin="12,0,12,0"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=viewmodels:QuickHomePageViewModel}"
    d:DesignHeight="1200"
    d:DesignWidth="640"
    KeepAlive="True"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:WidthToColumnsConverter x:Key="WidthToColumns" DesiredItemWidth="100" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ikw:SimpleStackPanel Spacing="8">
            <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{l:Static resx:Resources.QuickSettingsPage_Title}" />
            <ikw:SimpleStackPanel VerticalAlignment="Top" Spacing="3">
                <!--  Shortcuts  -->
                <ItemsControl
                    HorizontalAlignment="Left"
                    dd:DragDrop.DefaultDragAdornerOpacity="1"
                    dd:DragDrop.DragAdornerTranslation="-50,15"
                    dd:DragDrop.DropHandler="{Binding}"
                    dd:DragDrop.IsDragSource="True"
                    dd:DragDrop.IsDropTarget="True"
                    dd:DragDrop.UseDefaultDragAdorner="True"
                    ItemsSource="{Binding HotkeysList}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel
                                ItemHeight="160"
                                ItemWidth="100"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!--  Double-execute indicator: shown only when the command supports a double-tap action  -->
                                <!--
                                <ui:FontIcon
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Foreground="{DynamicResource AccentAAFillColorDefaultBrush}"
                                    Icon="{x:Static ui:SegoeFluentIcons.Click}"
                                    ToolTip="This hotkey supports a double-tap action">
                                    <ui:FontIcon.Style>
                                        <Style TargetType="ui:FontIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDoubleExecute}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:FontIcon.Style>
                                </ui:FontIcon>
                                -->

                                <ikw:SimpleStackPanel Spacing="3">
                                    <ToggleButton
                                        Height="100"
                                        Margin="3"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding ExecuteCommand}"
                                        IsChecked="{Binding IsToggled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                        Tag="Hotkey">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="50px" />
                                                <RowDefinition Height="5px" />
                                                <RowDefinition Height="30px" />
                                            </Grid.RowDefinitions>

                                            <ui:FontIcon
                                                Width="24"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{Binding FontFamily, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                FontSize="{Binding FontSize, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                Glyph="{Binding LiveGlyph, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ui:FontIcon.Style>
                                                    <Style TargetType="ui:FontIcon">
                                                        <Setter Property="Grid.RowSpan" Value="1" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTriggerChord}" Value="False">
                                                                <Setter Property="Grid.RowSpan" Value="3" />
                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:FontIcon.Style>
                                            </ui:FontIcon>

                                            <Separator
                                                Grid.Row="1"
                                                BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                                BorderThickness="0,1,0,0"
                                                Opacity="0.25">
                                                <Separator.Style>
                                                    <Style TargetType="Separator">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTriggerChord}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Separator.Style>
                                            </Separator>

                                            <ItemsControl
                                                Grid.Row="2"
                                                HorizontalAlignment="Center"
                                                ItemsSource="{Binding TriggerChordParts, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTriggerChord}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>

                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Height="24"
                                                            MinWidth="24"
                                                            Background="{DynamicResource NavigationViewContentGridBorderBrush}"
                                                            CornerRadius="3">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontFamily="{Binding FontFamily}"
                                                                FontSize="{Binding FontSize}"
                                                                Text="{Binding Glyph}"
                                                                TextAlignment="Center"
                                                                TextWrapping="Wrap" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ToggleButton>

                                    <TextBlock
                                        FontSize="12"
                                        Text="{Binding LiveName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </ikw:SimpleStackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ikw:SimpleStackPanel>
        </ikw:SimpleStackPanel>

        <ikw:SimpleStackPanel
            Grid.Row="1"
            VerticalAlignment="Bottom"
            Spacing="6">


            <Border Padding="6"
                Background="{DynamicResource ExpanderHeaderBackground}"
                CornerRadius="{DynamicResource ControlCornerRadius}">
                <StackPanel IsEnabled="{Binding SupportsTDP, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                    <DockPanel Margin="0,0,0,12">
                        <ui:FontIcon
                            Width="40"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                            Glyph="&#xe945;" />
                        <TextBlock Margin="12,0,0,0" Style="{StaticResource BodyTextBlockStyle}" Text="{l:Static resx:Resources.ProfilesPage_TDPOverride}" />
                    </DockPanel>
                    <ikw:SimpleStackPanel Margin="0,0,12,0" VerticalAlignment="Center" Spacing="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="5*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,12,0" Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:SettingsCard}}">
                                <StackPanel Width="40" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                                    <TextBlock Margin="0,0,0,0" FontSize="11" HorizontalAlignment="Center">PL1</TextBlock>
                                    <DockPanel HorizontalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}" Text="{Binding PL1OverrideValue, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" />
                                        <TextBlock
                                            Margin="0,0,0,0"
                                            Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                            Text="W" />
                                    </DockPanel>
                                </StackPanel>

                                <ui:AppBarSeparator />
                                <Slider
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutoToolTipPrecision="0"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="5"
                                    Maximum="{Binding ConfigurableTDPOverrideUp, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="{Binding ConfigurableTDPOverrideDown, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    SmallChange="1"
                                    TickFrequency="1"
                                    ToolTip="{Binding Value, StringFormat=N0, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                    Value="{Binding PL1OverrideValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="0,0,0,0" Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:SettingsCard}}">
                                <StackPanel Width="40" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                                    <TextBlock Margin="0,0,0,0" FontSize="11" HorizontalAlignment="Center">PL2</TextBlock>
                                    <DockPanel HorizontalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}" Text="{Binding PL2OverrideValue, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" />
                                        <TextBlock
                                            Margin="0,0,0,0"
                                            Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                            Text="W" />
                                    </DockPanel>
                                </StackPanel>

                                <ui:AppBarSeparator />
                                <Slider
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutoToolTipPrecision="0"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="5"
                                    Maximum="{Binding ConfigurableTDPOverrideUp, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="{Binding ConfigurableTDPOverrideDown, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    SmallChange="1"
                                    TickFrequency="1"
                                    ToolTip="{Binding Value, StringFormat=N0, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                    Value="{Binding PL2OverrideValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </Grid>

                    </ikw:SimpleStackPanel>
                </StackPanel>
            </Border>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <ikw:SimpleStackPanel
                    Grid.Column="0"
                    Margin="0,0,3,0"
                    Background="{DynamicResource ExpanderHeaderBackground}"
                    Spacing="3">
                    <DockPanel Margin="6,6,6,0">
                        <TextBlock Style="{StaticResource BaseTextBlockStyle}" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" Text="CPU" />
                        <TextBlock
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{Binding CPUName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="NoWrap" />
                    </DockPanel>
                    <!--  CPU Power Background="{DynamicResource ExpanderHeaderBackground}" -->
                    <Border
                        Height="70"
                        Padding="6"
                        CornerRadius="{DynamicResource ControlCornerRadius}">

                        <ikw:SimpleStackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Orientation="Horizontal"
                            Spacing="4">
                            <StackPanel VerticalAlignment="Center">
                                <Grid>
                                    <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xe964;" />
                                    <ui:ProgressRing
                                        d:Value="2050"
                                        Maximum="{Binding CPUClockMaximum, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsIndeterminate="False"
                                        Value="{Binding CPUClock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" />
                                </Grid>
                                <DockPanel>
                                    <TextBlock
                                        MinWidth="20"
                                        d:Text="2050"
                                        TextAlignment="Right"
                                        Text="{Binding CPUClock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock VerticalAlignment="Center" d:Text="MHz" Text="{Binding CPUClockUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}" />
                                </DockPanel>
                            </StackPanel>

                            <ui:AppBarSeparator />
                            
                            <StackPanel VerticalAlignment="Center">
                                <ui:FontIcon
                                    Height="31"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    Glyph="&#xe945;" />
                                <DockPanel>
                                    <TextBlock
                                        MinWidth="20"
                                        d:Text="100"
                                        TextAlignment="Right"
                                        Text="{Binding CPUPower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock VerticalAlignment="Center" Text="W" Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}" />
                                </DockPanel>
                            </StackPanel>

                            <ui:AppBarSeparator />
                            <StackPanel VerticalAlignment="Center">
                                <ui:FontIcon
                                    Height="31"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    Glyph="&#xe9ca;" />
                                <DockPanel>
                                    <TextBlock
                                        MinWidth="20"
                                        d:Text="100"
                                        TextAlignment="Right"
                                        Text="{Binding CPUTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock VerticalAlignment="Center" Text="°" Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}" />
                                </DockPanel>
                            </StackPanel>

                            <ui:AppBarSeparator />
                            <StackPanel VerticalAlignment="Center">
                                <Grid>
                                    <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xeea1;" />
                                    <ui:ProgressRing
                                        d:Value="50"
                                        IsIndeterminate="False"
                                        Value="{Binding CPULoad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <DockPanel>
                                    <TextBlock
                                        MinWidth="20"
                                        d:Text="50"
                                        TextAlignment="Right"
                                        Text="{Binding CPULoad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}">
                                        %
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </ikw:SimpleStackPanel>
                    </Border>
                </ikw:SimpleStackPanel>

                <ikw:SimpleStackPanel
                    Grid.Column="1"
                    Margin="3,0,0,0"
                    Background="{DynamicResource ExpanderHeaderBackground}"
                    Spacing="3">
                    <DockPanel Margin="6,6,6,0">
                        <TextBlock Style="{StaticResource BaseTextBlockStyle}" FontSize="12" Margin="0,0,4,0" Text="GPU" />
                        <TextBlock
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{Binding GPUName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="NoWrap" />
                    </DockPanel>
                    <!--  GPU Power  Background="{DynamicResource ExpanderHeaderBackground}" -->
                    <Border
                        Height="70"
                        Padding="6"
                        CornerRadius="{DynamicResource ControlCornerRadius}">

                        <ikw:SimpleStackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Orientation="Horizontal"
                            Spacing="4">

                            <StackPanel VerticalAlignment="Center" Visibility="{Binding HasGPUPower, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:FontIcon
                                    Height="31"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    Glyph="&#xe945;" />
                                <DockPanel>
                                    <TextBlock
                                        MinWidth="20"
                                        d:Text="100"
                                        TextAlignment="Right"
                                        Text="{Binding GPUPower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock VerticalAlignment="Center" Text="W" Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}" />
                                </DockPanel>
                            </StackPanel>

                            <ui:AppBarSeparator />
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding HasGPUTemperature, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:FontIcon
                                    Height="31"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    Glyph="&#xe9ca;" />
                                <DockPanel>
                                    <TextBlock
                                        MinWidth="20"
                                        d:Text="100"
                                        TextAlignment="Right"
                                        Text="{Binding GPUTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock VerticalAlignment="Center" Text="°" Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}" />
                                </DockPanel>
                            </StackPanel>

                            <ui:AppBarSeparator />
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding HasGPULoad, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xe964;" />
                                    <ui:ProgressRing
                                        d:Value="50"
                                        IsIndeterminate="False"
                                        Value="{Binding GPULoad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <DockPanel>
                                    <TextBlock
                                        MinWidth="20"
                                        d:Text="50"
                                        TextAlignment="Right"
                                        Text="{Binding GPULoad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock VerticalAlignment="Center" Text="%" Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}" />
                                </DockPanel>
                            </StackPanel>
                        </ikw:SimpleStackPanel>
                    </Border>
                </ikw:SimpleStackPanel>
            </Grid>

            <Border Padding="6"
                Background="{DynamicResource ExpanderHeaderBackground}"
                CornerRadius="{DynamicResource ControlCornerRadius}">
                <DockPanel>
                    <StackPanel Width="40" VerticalAlignment="Center">
                        <Grid>
                            <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xec48;" />
                            <ui:ProgressRing
                                d:Value="50"
                                Maximum="100"
                                IsIndeterminate="False"
                                Value="{Binding CPUFanLoad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel>
                            <TextBlock
                                MinWidth="20"
                                d:Text="50"
                                TextAlignment="Center"
                                Text="{Binding CPUFanSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock VerticalAlignment="Top" d:Text="RPM" Text="RPM" HorizontalAlignment="Center" Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}" />

                        </StackPanel>
                    </StackPanel>
                    <ui:AppBarSeparator />
                    <ikw:SimpleStackPanel Margin="12,0,12,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{l:Static resx:Resources.PerformancePage_FanMode_Title}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="2.5*" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton
                                Margin="0,0,4,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                IsChecked="{Binding IsFanModeHardware, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                Command="{Binding FanPresetHardwareCommand}"
                                Content="{l:Static resx:Resources.PerformancePage_FanMode_Hardware}" />
                            <ToggleButton
                                Grid.Column="1"
                                Margin="0,0,4,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                IsChecked="{Binding IsFanModeBalance, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                Command="{Binding FanPresetSoftwareCommand}"
                                Content="{l:Static resx:Resources.PerformancePage_FanMode_Preset_Default}" />
                            <ToggleButton
                                Grid.Column="2"
                                Margin="0,0,4,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                IsChecked="{Binding IsFanModeQuiet, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                Command="{Binding FanPresetSilentCommand}"
                                Content="{l:Static resx:Resources.PerformancePage_FanMode_Preset_Quiet}" />
                            <ToggleButton
                                Grid.Column="3"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                IsChecked="{Binding IsFanModeTurbo, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                Command="{Binding FanPresetTurboCommand}"
                                Content="{l:Static resx:Resources.PerformancePage_FanMode_Preset_Aggressive}" />
                        </Grid>
                        <DockPanel>

                            <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="30">
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}" Text="{Binding FanSpeedOverrideValue, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,0"
                                    Foreground="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                    Text="%" />
                            </DockPanel>
                            <ikw:SimpleStackPanel Margin="4,0,12,0" VerticalAlignment="Center" Spacing="4">
                                <Slider
                                    x:Name="SliderFan"
                                    IsEnabled="{Binding SupportsFanMode, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="10"
                                    Maximum="100"
                                    Minimum="0"
                                    SmallChange="1"
                                    TickFrequency="1"
                                    ToolTip="{Binding Value, StringFormat=N0, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                    Value="{Binding FanSpeedOverrideValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </ikw:SimpleStackPanel>
                        </DockPanel>
                    </ikw:SimpleStackPanel>
                </DockPanel>
            </Border>

            <Border Padding="6"
                    Background="{DynamicResource ExpanderHeaderBackground}"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <StackPanel Orientation="Vertical">
                    <DockPanel>
                        <Button 
                            Name="BrightnessButton"
                            IsEnabled="False"
                            Click="BrightnessButton_Click"
                            Height="40" Width="40"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            BorderBrush="{x:Null}"
                            Background="{x:Null}"
                            Padding="0,0,0,0">
                            <ui:FontIcon
                                Name="LightIcon"
                                Height="40"
                                HorizontalAlignment="Center"
                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                Glyph="&#xE706;" />
                        </Button>
                        <ikw:SimpleStackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                            <Slider
                                x:Name="SliderBrightness"
                                IsEnabled="False"
                                IsMoveToPointEnabled="True"
                                IsSnapToTickEnabled="True"
                                LargeChange="10"
                                Maximum="100"
                                Minimum="0"
                                SmallChange="1"
                                TickFrequency="1"
                                ToolTip="{Binding Value, StringFormat=N0, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                ValueChanged="SliderBrightness_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <Button 
                                Name="VolumeButton"
                                IsEnabled="False"
                                Click="VolumeButton_Click"
                                Height="40" Width="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                BorderBrush="{x:Null}"
                                Background="{x:Null}"
                                Padding="0,0,0,0">
                                <ui:FontIcon
                                    Name="VolumeIcon"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    Glyph="&#xE767;" />
                            </Button>
                            <ikw:SimpleStackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                                <Slider
                                    x:Name="SliderVolume"
                                    IsEnabled="False"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="10"
                                    Maximum="100"
                                    Minimum="0"
                                    SmallChange="1"
                                    TickFrequency="1"
                                    ToolTip="{Binding Value, StringFormat=N0, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                    ValueChanged="SliderVolume_ValueChanged" />
                            </ikw:SimpleStackPanel>
                        </DockPanel>
                        <DockPanel Grid.Column="1">
                            <Button 
                                Name="MicButton"
                                IsEnabled="False"
                                Click="MicButton_Click"
                                Height="40" Width="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                BorderBrush="{x:Null}"
                                Background="{x:Null}"
                                Padding="0,0,0,0">
                                <ui:FontIcon
                                    Name="MicIcon"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    Glyph="&#xe720;" />
                            </Button>
                            <ikw:SimpleStackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                                <Slider
                                    x:Name="SliderMic"
                                    IsEnabled="False"
                                    IsMoveToPointEnabled="True"
